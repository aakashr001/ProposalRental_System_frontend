{
	"_version": "1.89.0",
	"sap.app": {
		"id": "ns.proposalrentelsystem",
		"type": "application",
		"i18n": {
			"bundleUrl": "i18n/i18n.properties",
			"supportedLocales": [
				""
			]
		},
		"applicationVersion": {
			"version": "0.0.1"
		},
		"title": "{{appTitle}}",
		"description": "{{appDescription}}",
		"resources": "resources.json",
		"sourceTemplate": {
			"id": "@sap/generator-fiori:basic",
			"version": "1.32.0",
			"toolsId": "542ee2fd-f24d-43d1-ade8-98e4a135348a"
		},
		"dataSources": {
			"mainService": {
				"uri": "/odata/v4/customerapi/",
				"type": "OData",
				"settings": {
					"annotations": [],
					"localUri": "localService/mainService/metadata.xml",
					"odataVersion": "4.0"
				}
			}
		},
		"crossNavigation": {
			"inbounds": {
				"PRS-manage": {
					"semanticObject": "PRS",
					"action": "manage",
					"title": "{{PRS-manage.flpTitle}}",
					"signature": {
						"parameters": {},
						"additionalParameters": "allowed"
					}
				}
			}
		}
	},
	"sap.ui": {
		"technology": "UI5",
		"icons": {
			"icon": "",
			"favIcon": "",
			"phone": "",
			"phone@2": "",
			"tablet": "",
			"tablet@2": ""
		},
		"deviceTypes": {
			"desktop": true,
			"tablet": true,
			"phone": true
		}
	},
	"sap.ui5": {
		"flexEnabled": false,
		"dependencies": {
			"minUI5Version": "1.152.0",
			"libs": {
				"sap.m": {},
				"sap.ui.core": {},
				"sap.uxap": {},
				"sap.ui.layout": {}
			}
		},
		"contentDensities": {
			"compact": true,
			"cozy": true
		},
		"models": {
			"i18n": {
				"type": "sap.ui.model.resource.ResourceModel",
				"settings": {
					"bundleName": "ns.proposalrentelsystem.i18n.i18n",
					"supportedLocales": [
						""
					]
				}
			},
			"": {
				"dataSource": "mainService",
				"preload": true,
				"settings": {
					"operationMode": "Server",
					"autoExpandSelect": true,
					"earlyRequests": true
				}
			}
		},
		"resources": {
			"css": [
				{
					"uri": "css/style.css"
				}
			]
		},
		"routing": {
			"config": {
				"routerClass": "sap.m.routing.Router",
				"controlAggregation": "pages",
				"controlId": "app",
				"transition": "slide",
				"type": "View",
				"viewType": "XML",
				"path": "ns.proposalrentelsystem.view",
				"async": true,
				"viewPath": "ns.proposalrentelsystem.view"
			},
			"routes": [
				{
					"name": "RouteCustomer_View",
					"pattern": "",
					"target": [
						"TargetCustomer_View"
					]
				},
				{
					"name": "ProposalHistory",
					"pattern": "ProposalHistory",
					"target": [
						"ProposalHistory"
					]
				},
				{
					"name": "Registation",
					"pattern": "Registation",
					"target": [
						"Registation"
					]
				},
				{
					"name": "createProposal",
					"pattern": "createProposal",
					"target": "createProposal"
				}
			],
			"targets": {
				"TargetCustomer_View": {
					"id": "Customer_View",
					"name": "Customer_View"
				},
				"ProposalHistory": {
					"id": "ProposalHistory",
					"name": "ProposalHistory"
				},
				"Registation": {
					"id": "Registation",
					"name": "Registation"
				},
				"createProposal": {
					"name": "CreateProposal",
					"id": "createProposal"
				}
			}
		},
		"rootView": {
			"viewName": "ns.proposalrentelsystem.view.App",
			"type": "XML",
			"id": "App",
			"async": true
		},
		"flexBundle": false
	},
	"sap.cloud": {
		"public": true,
		"service": "nsproposalrentelsystem"
	}
}