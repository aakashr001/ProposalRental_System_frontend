<mvc:View controllerName="ns.proposalrentelsystem.controller.CreateProposal"
    xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:core="sap.ui.core">
 
    <Dialog
        id="createProposalDialog"
        title="Create Proposal"
        contentWidth="60rem"
        resizable="true"
        draggable="true">
 
        <content>
            <VBox class="sapUiSmallMargin">
 
                <Table items="{ path: 'draft>/items', templateShareable: false }"
                       width="100%" class="sapUiSmallMarginTop"
                       noDataText="No items. Click 'Add Item'.">
 
                    <headerToolbar>
                        <OverflowToolbar>
                            <Title text="Items"/>
                            <ToolbarSpacer/>
                            <Button icon="sap-icon://add" text="Add Item" type="Emphasized" press=".onAddItem"/>
                        </OverflowToolbar>
                    </headerToolbar>
 
                    <columns>
                        <Column vAlign="Middle" minScreenWidth="Tablet" demandPopin="true"><Text text="Product"/></Column>
                        <Column vAlign="Middle" width="9rem" minScreenWidth="Tablet" demandPopin="true"><Text text="Quantity"/></Column>
                        <Column vAlign="Middle" width="11rem" minScreenWidth="Tablet" demandPopin="true"><Text text="Start Date"/></Column>
                        <Column vAlign="Middle" width="11rem" minScreenWidth="Tablet" demandPopin="true"><Text text="End Date"/></Column>
                        <!-- <Column vAlign="Middle" width="9rem" minScreenWidth="Tablet" demandPopin="true"><Text text="Operators"/></Column> -->
                        <Column vAlign="Middle" width="9rem" hAlign="End"><Text text="Estimate"/></Column>
                        <Column vAlign="Middle" width="3.5rem" hAlign="Center"/>
                    </columns>
 
                    <items>
                        <ColumnListItem vAlign="Middle">
                            <cells>
                                <ComboBox selectedKey="{draft>product_ID}" width="100%"
                                          placeholder="Select product"
                                          selectionChange=".onProductChange"
                                          items="{ path: '/Product', sorter: { path: 'product_Name' },
                                                   parameters: { $select: 'ID,product_Code,product_Name,basePrice' },
                                                   templateShareable: false }">
                            
                                    <core:ListItem key="{ID}" text="{product_Name}" additionalText="{product_Code}"/>
                                </ComboBox>
 
                                <StepInput value="{draft>quantity}" min="1" max="99" width="100%" change=".onRecalc"/>
 
                                <DatePicker value="{draft>startDate}" valueFormat="yyyy-MM-dd"
                                            displayFormat="dd MMM yyyy" width="100%"
                                            minDate="{draft>/minDate}"
                                            placeholder="Start date" change=".onRecalc"/>
 
                                <DatePicker value="{draft>endDate}" valueFormat="yyyy-MM-dd"
                                            displayFormat="dd MMM yyyy" width="100%"
                                            minDate="{path: 'draft>startDate', formatter: '.formatEndMinDate'}"
                                            placeholder="End date" change=".onRecalc"/>
 
                                <!-- <StepInput value="{draft>needed_machineOperator}" min="0" max="99" width="100%"/> -->
                                <ObjectNumber number="{draft>estimate}" unit="INR" emphasized="true"/>
                                <Button icon="sap-icon://delete" type="Transparent" tooltip="Remove item" press=".onRemoveItem"/>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
 
                <HBox justifyContent="End" class="sapUiSmallMarginTop">
                    <Label text="Total Estimate:" class="sapUiSmallMarginEnd"/>
                    <ObjectNumber number="{draft>/total}" unit="INR" emphasized="true"/>
                </HBox>
 
            </VBox>
        </content>
 
        <beginButton>
            <Button text="Submit" type="Emphasized" press=".onSubmitProposal"/>
        </beginButton>
        <endButton>
            <Button text="Cancel" press=".onCancelCreate"/>
        </endButton>
 
    </Dialog>
</mvc:View>