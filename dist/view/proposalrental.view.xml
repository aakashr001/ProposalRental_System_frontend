<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    controllerName="proposalrental.controller.proposalrental">

    <Page
        id="proposalRentalPage"
        title="Proposal &amp; Rental Management">

        <content>

            <VBox class="sapUiSmallMargin">

                <Title
                    text="Filters"
                    level="H3"
                    class="sapUiSmallMarginBottom"/>

                <HBox
                    alignItems="End"
                    wrap="Wrap">

                    <VBox
                        width="450px"
                        class="sapUiSmallMarginEnd">

                        <Label
                            text="Date Range"
                            labelFor="dateRange"/>

                        <DateRangeSelection
                            id="dateRange"
                            width="100%"
                            displayFormat="MMM dd, yyyy"
                            delimiter=" - "
                            placeholder="Select date range"/>

                    </VBox>

                    <Button
                        id="goButton"
                        text="Go"
                        icon="sap-icon://filter"
                        type="Emphasized"
                        press="onApplyFilters"
                        class="sapUiSmallMarginEnd"/>

                    <Button
                        id="clearButton"
                        text="Clear"
                        icon="sap-icon://clear-filter"
                        press="onClearFilters"/>

                </HBox>

            </VBox>


            <VBox class="sapUiSmallMargin">

                <Toolbar>

                    <Title
                        text="Approved Proposals"
                        level="H3"/>

                    <ToolbarSpacer/>

                    <Button
                        id="manageRentalButton"
                        text="Allocate &amp; Create Rental"
                        icon="sap-icon://shipping-status"
                        type="Emphasized"
                        enabled="false"
                        press="onManageRental"/>

                    <Button
                        id="refreshButton"
                        icon="sap-icon://refresh"
                        type="Transparent"
                        tooltip="Refresh"
                        press="onRefresh"/>

                </Toolbar>


                <Table
                    id="proposalTable"
                    width="100%"
                    growing="true"
                    growingThreshold="20"
                    noDataText="No approved proposals found"
                    mode="SingleSelectLeft"
                    selectionChange="onProposalSelectionChange"
                    items="{view>/proposals}">

                    <columns>

                        <Column>
                            <Text text="Proposal No"/>
                        </Column>

                        <Column>
                            <Text text="Date"/>
                        </Column>

                        <Column>
                            <Text text="Type"/>
                        </Column>

                        <Column>
                            <Text text="Status"/>
                        </Column>

                        <Column hAlign="End">
                            <Text text="Total Amount"/>
                        </Column>

                        <Column hAlign="Center">
                            <Text text="View Details"/>
                        </Column>

                    </columns>


                    <items>

                        <ColumnListItem>

                            <cells>

                                <Text
                                    text="{view>proposalNumber}"/>

                                <Text
                                    text="{view>proposalDate}"/>

                                <Text
                                    text="{view>proposalType}"/>

                                <ObjectStatus
                                    text="{view>proposalStatus}"
                                    state="{path: 'view>proposalStatus', formatter: '.formatStatusState'}"/>

                                <ObjectNumber
                                    number="{view>totalAmount}"/>

                                <Button
                                    text="View Details"
                                    icon="sap-icon://display"
                                    type="Transparent"
                                    press="onViewDetails"/>

                            </cells>

                        </ColumnListItem>

                    </items>

                </Table>

            </VBox>

        </content>

    </Page>

</mvc:View>