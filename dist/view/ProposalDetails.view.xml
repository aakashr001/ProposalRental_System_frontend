
<mvc:View
    controllerName="ns.proposalrentelsystem.controller.ProposalDetails"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:form="sap.ui.layout.form">

    <Page
        id="proposalDetailsPage"
        title="My Proposal Details"
        showNavButton="true"
        navButtonPress=".onNavBack"
        enableScrolling="true">

        <content>
            <VBox width="100%" class="logoimage">

                <!-- Proposal Header -->
                <VBox
                    width="100%"
                    class="sapUiResponsiveContentPadding">

                    <Title
                        text="{proposalModel>/proposalNumber}"
                        level="H1"
                        class="sapUiSmallMarginBottom"/>

                    <Text
                        text="{proposalModel>/proposalType}"
                        class="sapUiTinyMarginBottom"/>

                    <HBox
                    alignItems="Center"
                    wrap="Wrap"
                    class="sapUiSmallMarginBottom">

                    <Label
                        text="Status:"
                        class="sapUiTinyMarginEnd"/>

                    <ObjectStatus
                        text="{proposalModel>/proposalStatus}"
                        state="Information"
                        class="sapUiTinyMarginEnd"/>

                    <Label
                        text="Total Amount:"
                        class="sapUiTinyMarginBegin sapUiTinyMarginEnd"/>

                    <ObjectNumber
                        number="{proposalModel>/totalAmount}"
                        emphasized="true"/>

                </HBox>


                </VBox>

                <!-- Proposal Tabs -->
                <IconTabBar
                    id="proposalDetailsTabs"
                    expandable="false"
                    selectedKey="information"
                    applyContentPadding="false">

                    <items>



                        <!-- General Information -->
                        <IconTabFilter
                            key="information"
                            text="GENERAL INFORMATION"
                            icon="sap-icon://document-text">

                            <VBox
                                width="100%"
                                class="sapUiResponsiveContentPadding">

                                <Title
                                    text="General Information"
                                    level="H2"
                                    class="sapUiSmallMarginBottom"/>

                                <Panel
                                    width="100%"
                                    expandable="false"
                                    backgroundDesign="Solid">

                                    <content>
                                        <form:SimpleForm
                                            editable="false"
                                            layout="ResponsiveGridLayout"
                                            labelSpanXL="3"
                                            labelSpanL="3"
                                            labelSpanM="4"
                                            labelSpanS="12"
                                            columnsXL="2"
                                            columnsL="2"
                                            columnsM="1"
                                            singleContainerFullSize="false"
                                            adjustLabelSpan="false"
                                            class="sapUiMediumMargin">

                                            <Label text="Proposal Number"/>
                                            <Text
                                                text="{proposalModel>/proposalNumber}"
                                                wrapping="true"/>

                                            <Label text="Proposal ID"/>
                                            <Text
                                                text="{proposalModel>/ID}"
                                                wrapping="true"/>

                                            <Label text="Proposal Date"/>
                                            <Text
                                                text="{proposalModel>/proposalDate}"
                                                wrapping="true"/>

                                            <Label text="Proposal Type"/>
                                            <Text
                                                text="{proposalModel>/proposalType}"
                                                wrapping="true"/>

                                            <Label text="Proposal Status"/>
                                            <ObjectStatus
                                                text="{proposalModel>/proposalStatus}"
                                                state="Information"/>

                                            <Label text="Total Amount"/>
                                            <ObjectNumber
                                                number="{proposalModel>/totalAmount}"
                                                emphasized="true"/>

                                        </form:SimpleForm>
                                    </content>

                                </Panel>
                            </VBox>
                        </IconTabFilter>

                        <!-- Equipment Details -->
                        <IconTabFilter
                            key="equipment"
                            text="EQUIPMENT DETAILS"
                            icon="sap-icon://wrench">

                            <VBox
                                width="100%"
                                class="sapUiResponsiveContentPadding">

                                <Title
                                    text="Equipment Requested in This Proposal"
                                    level="H2"
                                    class="sapUiSmallMarginBottom"/>

                                <Panel
                                    width="100%"
                                    expandable="false"
                                    backgroundDesign="Solid">

                                    <content>
                                        <Table
                                            id="equipmentDetailsTable"
                                            width="100%"
                                            inset="false"
                                            growing="true"
                                            growingScrollToLoad="true"
                                            noDataText="No matching equipment found for this proposal"
                                            items="{equipmentModel>/equipment}">

                                            <columns>
                                                <Column>
                                                    <Text text="Equipment Code"/>
                                                </Column>

                                                <Column>
                                                    <Text text="Equipment Name"/>
                                                </Column>

                                                <Column>
                                                    <Text text="Serial Number"/>
                                                </Column>

                                                <Column>
                                                    <Text text="Model"/>
                                                </Column>

                                                <!-- <Column>
                                                    <Text text="Status"/>
                                                </Column> -->
                                            </columns>

                                            <items>
                                                <ColumnListItem>
                                                    <cells>
                                                        <Text
                                                            text="{equipmentModel>equipmentCode}"
                                                            wrapping="true"/>

                                                        <Text
                                                            text="{equipmentModel>equipmentName}"
                                                            wrapping="true"/>

                                                        <Text
                                                            text="{equipmentModel>serialNumber}"
                                                            wrapping="true"/>

                                                        <Text
                                                            text="{equipmentModel>model}"
                                                            wrapping="true"/>

                                                        <!-- <ObjectStatus
                                                            text="{equipmentModel>status}"
                                                            state="Information"/> -->
                                                    </cells>
                                                </ColumnListItem>
                                            </items>

                                        </Table>
                                    </content>

                                </Panel>
                            </VBox>
                        </IconTabFilter>

                    </items>
                </IconTabBar>

            </VBox>
        </content>

    </Page>
</mvc:View>