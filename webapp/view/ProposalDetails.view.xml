
<mvc:View
    xmlns:layout="sap.ui.layout"
    controllerName="ns.proposalrentelsystem.controller.ProposalDetails"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:m="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns="sap.uxap"
    xmlns:form="sap.ui.layout.form">

    <m:Page showNavButton="true" navButtonPress=".onNavBack" enableScrolling="true" title="My Proposal Details">
            <ObjectPageLayout id="ObjectPageLayout"
                showTitleInHeaderContent="true"
                showEditHeaderButton="true"
                headerContentPinnable="true"
                showFooter="true"
            >

                <headerTitle>
                    <ObjectPageDynamicHeaderTitle>
                        <expandedHeading>
                            <m:HBox>
                                <m:Title text="{proposalNumber}" class="sapUiSmallMarginBottom"></m:Title>
                            </m:HBox>
                        </expandedHeading>

                    </ObjectPageDynamicHeaderTitle>
                </headerTitle>

                <headerContent>
                    <layout:VerticalLayout>
                        <m:HBox>
                            <m:Text text="Status" class="sapUiSmallMarginEnd"></m:Text>
                            <m:ObjectStatus text="{proposalStatus}" state="{= ${proposalStatus} === 'Approved' ? 'Success' : 'Error'}" ></m:ObjectStatus>
                        </m:HBox>
                        <m:HBox>
                            <m:Text text="Total Amount" class="sapUiSmallMarginEnd"></m:Text>
                            <m:ObjectStatus text="{totalAmount}"></m:ObjectStatus>
                        </m:HBox>
                    </layout:VerticalLayout>
                </headerContent>

                <sections>
                    <ObjectPageSection titleUppercase="false" id="proposalSection" title="Proposal Details">
                        <subSections>
                            <ObjectPageSubSection 
                                id="proposalInformation"
                                title="Proposal Information"
                            >
                                <blocks>
                                    <f:SimpleForm
                                        editable="false"
                                        layout="ResponsiveGridLayout"
                                        columnsL="2"
                                        columnsM="2"
                                        columnsXL="2"
                                        labelSpanL="4"
                                        labelSpanM="4"
                                        labelSpanXL="4"
                                        adjustLabelSpan="false"
                                    >

                                        <m:Label text="Proposal Number"></m:Label>
                                        <m:Text text="{proposalNumber}"></m:Text>

                                        <m:Label text="Proposal ID"></m:Label>
                                        <m:Text text="{ID}"></m:Text>
                                        
                                        <m:Label text="Proposal Date"></m:Label>
                                        <m:Text text="{proposalDate}"></m:Text>
                                        
                                        <m:Label text="Proposal Type"></m:Label>
                                        <m:Text text="{proposalType}"></m:Text>
                                        
                                        <m:Label text="Proposal Status"></m:Label>
                                        <m:Text text="{proposalStatus}"></m:Text>
                                        
                                        <m:Label text="Total Amount"></m:Label>
                                        <m:Text text="{totalAmount}"></m:Text>  
<!--                                         
                                        <m:Label text="Customer Name"></m:Label>
                                        <m:Text text="{customer/companyName}"></m:Text> -->

                                    </f:SimpleForm>
                                </blocks>
                            </ObjectPageSubSection>
                        </subSections>
                    </ObjectPageSection>

                    <ObjectPageSection titleUppercase="false" id="proposalItemsSection">
                        <subSections>
                            <ObjectPageSubSection 
                                id="proposalItemsInformation"
                                title="Proposal Items"
                            >
                                <blocks>
                                    <m:Table id="idproposalItemTable" mode="MultiSelect"
                                    items= "{ path : 'items' }"
                                    >
                                        <m:columns>
                                            <m:Column>
                                                <m:Text text="Product Name"></m:Text>
                                            </m:Column>
                                            <m:Column>
                                                <m:Text text="Quantity"></m:Text>
                                            </m:Column>
                                            <m:Column>
                                                <m:Text text="Unit Price"></m:Text>
                                            </m:Column>
                                           <m:Column>
                                                <m:Text text="Estimated Amount"></m:Text>
                                            </m:Column>
                                            <m:Column>
                                                <m:Text text="Rental Duration"></m:Text>
                                            </m:Column>
                                            <m:Column>
                                                <m:Text text="Start Date"></m:Text>
                                            </m:Column>
                                            <m:Column>
                                                <m:Text text="End Date"></m:Text>
                                            </m:Column>
                                        </m:columns>

                                        <m:items >
                                            <m:ColumnListItem>
                                                <m:cells>
                                                   <m:Text text="{product/product_Name}"></m:Text>
                                                    <m:Text text="{quantity}"></m:Text>
                                                    <m:Text text="{unitPrice}"></m:Text>
                                                    <m:Text text="{estimatedAmount}"></m:Text>
                                                    <m:Text text="{rentalDuration}"></m:Text>
                                                    <m:Text text="{startDate}"></m:Text>
                                                    <m:Text text="{endDate}"></m:Text>
                                              
                                                </m:cells>
                                            </m:ColumnListItem>
                                        </m:items>
                                    </m:Table>
                                </blocks>
                            </ObjectPageSubSection>
                        </subSections>
                    </ObjectPageSection>

                    
                </sections>

            </ObjectPageLayout>
        </m:Page>
    

   
</mvc:View>