<mvc:View
    controllerName="ns.proposalrentelsystem.controller.ProposalHistory"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true">

    <Page
        id="proposalHistoryPage"
        title="My Proposals"
        showNavButton="true"
        navButtonPress=".onBack"
        enableScrolling="true">

        <!-- ================= HEADER ================= -->
        <headerContent>
            <Button
                text="Create Proposal"
                icon="sap-icon://add"
                type="Emphasized"
                press=".onCreateProposal"/>
        </headerContent>

        <content>

            <!-- ================= PAGE INTRO ================= -->
            <VBox
                class="sapUiResponsiveContentPadding">

                <Title
                    text="My Proposals"
                    level="H1"
                    titleStyle="H2"/>

                <Text
                    text="View and manage your proposal history."
                    class="sapUiSmallMarginTop sapUiSmallMarginBottom"/>

            </VBox>


            <!-- ================= KPI CARDS ================= -->
            <HBox
                wrap="Wrap"
                justifyContent="SpaceBetween"
                class="sapUiResponsiveContentPadding">

                <!-- TOTAL -->
                <VBox
                    class="proposalCard proposalCardBlue">

                    <HBox
                        justifyContent="SpaceBetween"
                        alignItems="Center">

                        <VBox>
                            <Text
                                text="Total"
                                class="proposalCardTitle"/>

                            <ObjectNumber
                                number="{proposal>/total}"
                                emphasized="true"
                                class="proposalCardNumber"/>
                        </VBox>

                        <core:Icon
                            src="sap-icon://document-text"
                            size="2rem"
                            class="proposalCardIcon"/>
                    </HBox>

                </VBox>


                <!-- DRAFT -->
                <VBox
                    class="proposalCard proposalCardPurple">

                    <HBox
                        justifyContent="SpaceBetween"
                        alignItems="Center">

                        <VBox>
                            <Text
                                text="Draft"
                                class="proposalCardTitle"/>

                            <ObjectNumber
                                number="{proposal>/draft}"
                                emphasized="true"
                                class="proposalCardNumber"/>
                        </VBox>

                        <core:Icon
                            src="sap-icon://edit"
                            size="2rem"
                            class="proposalCardIcon"/>
                    </HBox>

                </VBox>


                <!-- SUBMITTED -->
                <VBox
                    class="proposalCard proposalCardOrange">

                    <HBox
                        justifyContent="SpaceBetween"
                        alignItems="Center">

                        <VBox>
                            <Text
                                text="Submitted"
                                class="proposalCardTitle"/>

                            <ObjectNumber
                                number="{proposal>/submitted}"
                                emphasized="true"
                                class="proposalCardNumber"/>
                        </VBox>

                        <core:Icon
                            src="sap-icon://paper-plane"
                            size="2rem"
                            class="proposalCardIcon"/>
                    </HBox>

                </VBox>


                <!-- APPROVED -->
                <VBox
                    class="proposalCard proposalCardGreen">

                    <HBox
                        justifyContent="SpaceBetween"
                        alignItems="Center">

                        <VBox>
                            <Text
                                text="Approved"
                                class="proposalCardTitle"/>

                            <ObjectNumber
                                number="{proposal>/approved}"
                                emphasized="true"
                                class="proposalCardNumber"/>
                        </VBox>

                        <core:Icon
                            src="sap-icon://accept"
                            size="2rem"
                            class="proposalCardIcon"/>
                    </HBox>

                </VBox>

            </HBox>


            <!-- ================= PROPOSAL HISTORY ================= -->

            <VBox
                class="proposalHistorySection sapUiResponsiveContentPadding">
                
                <HBox
                    justifyContent="SpaceBetween"
                    alignItems="Center"
                    class="proposalHistoryHeader">

                    <Title
                        text="Proposal History"
                        level="H2"
                        titleStyle="H4"/>

                    <Text
                        text="Your recent proposals"/>

                </HBox>


                <Table
                    id="proposalHistoryList"
                    items="{proposalModel>/}"
                    inset="false"
                    growing="true"
                    growingThreshold="10"
                    sticky="ColumnHeaders"
                    noDataText="No proposals yet. Select Create Proposal to start."
                    width="100%">

                    <columns>

                        <Column
                            minScreenWidth="Tablet"
                            demandPopin="true">
                            <Text text="Proposal"/>
                        </Column>

                        <Column
                            minScreenWidth="Tablet"
                            demandPopin="true">
                            <Text text="Type"/>
                        </Column>

                        <Column
                            minScreenWidth="Desktop"
                            demandPopin="true">
                            <Text text="Date"/>
                        </Column>

                        <Column
                            minScreenWidth="Tablet"
                            demandPopin="true">
                            <Text text="Status"/>
                        </Column>

                        <Column
                            hAlign="End"
                            minScreenWidth="Tablet"
                            demandPopin="true">
                            <Text text="Total Amount"/>
                        </Column>

                    </columns>


                    <items>

                        <ColumnListItem
                            type="Navigation"
                            press=".onProposalPress">

                            <cells>

                                <ObjectIdentifier
                                    title="{proposalModel>proposalNumber}"/>

                                <Text
                                    text="{proposalModel>proposalType}"/>

                                <Text
                                    text="{proposalModel>proposalDate}"/>

                                <ObjectStatus
                                    text="{proposalModel>proposalStatus}"
                                    state="{proposalModel>statusState}"
                                    inverted="true"/>

                                <ObjectNumber
                                    number="{proposalModel>totalAmount}"
                                    unit="₹"
                                    emphasized="true"/>

                            </cells>

                        </ColumnListItem>

                    </items>

                </Table>

            </VBox>   

        </content>

    </Page>

</mvc:View>